#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

echo
echo "========================================"
echo "   GADGET STORE OS - FULL TEST"
echo "========================================"
echo

echo "== ENVIRONMENT + DEPENDENCIES =="
"$ROOT/dev-setup"

echo
echo "== BACKEND TESTS =="
cd "$ROOT/backend"
source .venv/bin/activate
pytest -q

echo
echo "== FRONTEND TYPESCRIPT =="
cd "$ROOT/frontend"
npx tsc --noEmit

echo
echo "== FRONTEND PRODUCTION BUILD =="
npm run build

echo
echo "========================================"
echo "   ALL TESTS PASSED"
echo "========================================"
